{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build.py --no-fetch",
  "outputDirectory": "site",
  "framework": null,
  "crons": [
    {
      "path": "/api/check",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/advise",
      "schedule": "0 0-5,13-23 * * *"
    }
  ],
  "functions": {
    "api/check.js": {
      "maxDuration": 300
    },
    "api/advise.js": {
      "maxDuration": 300
    },
    "api/ask.js": {
      "maxDuration": 120
    },
    "api/sweep.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
